
# Daily WebRTC API key (Required for creating Daily rooms and meeting tokens)
DAILY_API_KEY=your_daily_api_key_here

# Deepgram STT API key (Required for real-time speech-to-text)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Cartesia TTS API key (Required for real-time text-to-speech)
CARTESIA_API_KEY=your_cartesia_api_key_here

# LLM Provider selection: "openai" (default) or "google"
LLM_PROVIDER=openai

# OpenAI API key (Required if LLM_PROVIDER is "openai")
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API key (Required if LLM_PROVIDER is "google")
GOOGLE_API_KEY=your_google_api_key_here

# Frontend Agent URL (Optional, defaults to http://localhost:8000)
NEXT_PUBLIC_AGENT_URL=http://localhost:8000
