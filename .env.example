# Daily API key for room creation and auth.
DAILY_API_KEY=
# Daily domain used for room connectivity.
DAILY_DOMAIN=
# LLM provider selection; set to "openai" or "anthropic".
LLM_PROVIDER=openai
# OpenAI API key used for the selected LLM provider.
OPENAI_API_KEY=
# Anthropic API key used when LLM_PROVIDER is set to "anthropic".
ANTHROPIC_API_KEY=
# Deepgram API key used for STT transcription.
DEEPGRAM_API_KEY=
# Text-to-speech provider selection; set to "cartesia" or "openai".
TTS_PROVIDER=cartesia
# Cartesia API key used when TTS_PROVIDER is set to "cartesia".
CARTESIA_API_KEY=
# Public URL of the agent backend used by the frontend.
NEXT_PUBLIC_AGENT_URL=http://localhost:8000
